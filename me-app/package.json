{
  "name": "embabel-me-app",
  "version": "0.0.1",
  "description": "Embabel Me sensor app \u2014 reads local macOS signals and sends them to your appliance",
  "main": "dist/main.js",
  "scripts": {
    "prestart": "node -e \"require('fs').existsSync('node_modules/electron') || process.exit(1)\" || npm install",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node dist/smoke.js",
    "typecheck": "tsc --noEmit",
    "prepackage": "npm run build",
    "package": "electron-builder --mac --dir",
    "predist": "npm run build",
    "dist": "electron-builder --mac"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/codemirror": "^5.60.18",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.embabel.me",
    "productName": "Embabel Me",
    "copyright": "Copyright \u00a9 Embabel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "index.html",
      "query-studio.html",
      "handler-studio.html",
      "logs.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Embabel Me reads the tab you are viewing and what is playing, and sends only that to your own appliance.",
        "LSUIElement": false
      },
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Embabel Me"
    }
  },
  "dependencies": {
    "@embabel/appliance-kit": "git+https://github.com/embabel-worlds/appliance-kit.git#main",
    "codemirror": "^5.65.21",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}
