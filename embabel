#!/usr/bin/env python3
"""The Embabel appliance, as a command rather than a directory.

    embabel up · status · doctor · version · ps · logs · realms · open · agents
    sample · scenario · backup · restore · bugreport · prune · upgrade
    down · uninstall

WHY THIS EXISTS. Everything below was already possible — as `cd ~/embabel-me &&
./worlds.py`, `./setup.py --uninstall`, `docker compose -f docker-compose-worlds.yml
ps`. That is a checkout's interface, and it asks a developer to remember which
directory the product lives in and which compose file today's mode uses. A product
gives you a verb.

IT DELEGATES, IT DOES NOT REIMPLEMENT. setup.py owns the hard parts — the docker
checks, the staged start, the wizard, the realms validation, the uninstall — and
this imports them. Two copies of "is Docker running" is how they come to disagree.

Python 3 standard library only, like everything else here, so it runs wherever the
appliance does with nothing installed.
"""

# THE VERSION GATE, BEFORE ANY embabel_setup IMPORT. The setup package is written for
# Python 3.10+ (`str | None` annotations evaluated at import, `match` statements), and
# macOS still ships 3.9 as `python3` — which died in a TypeError a new user cannot be
# expected to read. Fail as a sentence instead. install.sh prefers a 3.10+ interpreter
# when one exists; this guard catches the run that bypassed it.
import sys as _sys
if _sys.version_info < (3, 10):
    _sys.exit(
        "Embabel needs Python 3.10 or newer — this is Python "
        + _sys.version.split()[0]
        + ".\n  macOS:  brew install python@3.12   (then rerun the installer)"
        + "\n  Linux:  apt install python3.10  ·  dnf install python3.12"
    )
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
# Stated rather than relied upon: the package sits beside this file, and the failure
# mode of a caller whose cwd is elsewhere is an ImportError on the very first verb.
sys.path.insert(0, HERE)

# THE VERBS LIVE IN THE PACKAGE, grouped by what they are about — running it, what the
# world knows, looking after it — and cliparser owns the command surface. This file is
# the front door: it parses, it dispatches, it says where things live. It was 1191 lines
# when it also implemented them, which is a checkout's interface wearing a product's
# clothes.
from embabel_setup.cli import resolve_instance, s  # noqa: E402
from embabel_setup.cliparser import build_parser  # noqa: E402



def main() -> int:
    args = build_parser().parse_args()
    os.chdir(HERE)  # compose files live here; every verb below assumes it
    try:
        refused = resolve_instance(args)
    except s.SetupError as e:
        # A bad --instance is a user error, not a crash. This runs BEFORE the
        # try around the verb below, so without its own guard it escaped as a
        # traceback.
        print(f"\n  {e}\n", file=sys.stderr)
        return 1
    if refused:
        return refused

    if not args.command:
        rc = cmd_status(args)
        # ONE list of what to do next, shared with the end of setup. Two copies is
        # how the CLI and the wizard come to recommend different things.
        s.print_next()
        return rc
    try:
        return args.func(args)
    except s.SetupError as e:
        print(f"\n  {e}\n", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n  Interrupted.\n", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
