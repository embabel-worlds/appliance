# Your configuration — holds API keys. Never commit it.
# .envrc is the direnv equivalent and holds exactly the same secrets, so it is
# ignored for exactly the same reason: without this line it is one `git add -A`
# away from being published.
.env
.envrc

# Editor and OS noise. An operator clones this repo and runs it; anything their
# tooling drops here is theirs, not ours.
.idea/
*.iml
.vscode/
.DS_Store
__pycache__/
*.pyc
