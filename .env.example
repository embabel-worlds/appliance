# Embabel Me appliance — copy to `.env` in this directory and edit.
#
#   cp .env.example .env
#
# docker compose reads this file automatically. Nothing here is baked into an
# image; every value is read at container start, so editing it and running
# `docker compose up -d` is enough to apply a change.

# ── Required: at least one model provider ───────────────────────────────────
# The assistant cannot answer without one. OpenAI is the default provider for
# the shipped model configuration; Anthropic is used by the app builder.
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# ── MCP access ──────────────────────────────────────────────────────────────
# Bearer token for /mcp and /sse — how Claude Code, Claude Desktop, Open WebUI
# and anything else MCP-aware authenticates. Generate one with:
#   openssl rand -hex 32
# Leave EMPTY to disable token auth entirely (the MCP endpoints then reject
# every bearer client).
EMBABEL_MCP_API_TOKEN=
# The Embabel user whose world an MCP client acts as.
EMBABEL_MCP_API_TOKEN_USER=alice

# ── Optional: integration credentials ───────────────────────────────────────
# Each unlocks a capability and is inert when empty. Credentials are resolved at
# the integration layer and never injected into a prompt — the assistant can call
# a tool that needs a token without the model ever seeing it.
#BRAVE_API_KEY=            # web search
#GITHUB_TOKEN=             # GitHub realm: issues, PRs, repositories
#TELEGRAM_BOT_TOKEN=       # chat with the assistant from Telegram
#SLACK_APP_TOKEN=          # chat with the assistant from Slack

# ── Version ─────────────────────────────────────────────────────────────────
# The appliance tag. Every Embabel image in the compose file moves together;
# pin this to a release rather than tracking a floating tag.
#EMBABEL_VERSION=0.2.0-SNAPSHOT

# ── Optional services ───────────────────────────────────────────────────────
# Turn profile-gated services on here rather than passing `--profile` ad hoc:
# compose reconciles to the ACTIVE profile set on every `up`, so an ad-hoc
# profile means the next plain `up` silently stops those containers. It is ONE
# comma-separated list — set every profile you want on the same line.
#
#   openwebui — Open WebUI as an alternative chat front-end on :4245
#
# The Grafana dashboards are NOT here: they are ordinary services and run by
# default. A profile can only ever be OFF by default (compose activates one
# solely when COMPOSE_PROFILES names it), and this appliance is meant to start
# with no .env at all — so a profile would have meant no dashboards for anyone
# who never created this file. Turn them off by deleting the two services from
# docker-compose.yml.
#COMPOSE_PROFILES=openwebui
#OPEN_WEBUI_SECRET_KEY=
#OPEN_WEBUI_DEFAULT_MODEL=gpt-4.1
# How long Prometheus keeps samples. Costs disk in the prometheus volume.
#PROMETHEUS_RETENTION=15d

# ── Ports (host side) ───────────────────────────────────────────────────────
# All bind to 127.0.0.1 — see the security note in README.md before changing.
#ASSISTANT_PORT=4242
#NEO4J_BROWSER_PORT=4243
#NEO4J_BOLT_PORT=4244
#OPEN_WEBUI_PORT=4245
#GRAFANA_PORT=4246
#PROMETHEUS_PORT=4247

# ── Tuning ──────────────────────────────────────────────────────────────────
# Embedding model. The default is LOCAL — ai/qwen3-embedding, served by Docker
# Model Runner on the host (see the `models:` element in docker-compose.yml),
# so memory and document search cost no API tokens. Set a provider model such
# as text-embedding-3-small (needs OPENAI_API_KEY) to opt out of local
# embeddings. CHANGING THIS ON AN EXISTING INSTALL is a migration, not a tweak:
# stored vectors were made by the old model, so run the re-embed from
# Settings → Embedding model after switching.
#ASSISTANT_EMBEDDING_MODEL=ai/qwen3-embedding
# `none` = raw Tika text extraction; makes the (multi-GB) docling image
# unnecessary at the cost of table/figure fidelity in PDFs and office docs.
#ASSISTANT_DOC_CONVERTER=docling
#NEO4J_PASSWORD=embabel-assistant
#NEO4J_HEAP=2G
#JAVA_OPTS=-XX:MaxRAMPercentage=75

# ── Usage reporting ─────────────────────────────────────────────────────────
# The appliance reports anonymous usage data (counts and versions, never your
# data or code) to Embabel every 24 hours. Every field is listed in PHONE_HOME.md,
# and /api/v1/phone-home on your instance shows the exact JSON last sent.
#
# There is no setting here, deliberately: the collector is fixed in the image. A
# variable you could blank would be an opt-out by another name, and we would
# rather be straight about not offering one. Block it at your network if you must.

# ── Behind a proxy / on another host ────────────────────────────────────────
# The externally visible origin. OAuth callbacks, MCP resource indicators, and
# app/artifact links all compose from it. No trailing slash.
#ASSISTANT_PUBLIC_BASE_URL=http://localhost:4242
